{{- $pages := where .Site.RegularPages "Type" "!=" "page" -}}
{{- $index := slice -}}
{{- range $pages -}}
  {{- $index = $index | append (dict "title" .Title "url" .RelPermalink "date" (.Date.Format .Site.Params.dateformNum) "tags" .Params.tags "body" (.Plain | truncate 12000 "")) -}}
{{- end -}}
{{- $index | jsonify -}}
